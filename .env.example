# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MAX_VENDOR_CATALOGUE_SIZE_MB: Maximum allowed single vendor catalogue file size (default 250 MB)
MAX_VENDOR_CATALOGUE_SIZE_MB="250"

# SUPABASE CLIENT (Frontend-safe public URL and Publishable / Anon key)
VITE_SUPABASE_URL="https://plvjsiehhpdoyvzgahpr.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# SUPABASE SERVER (Server-side only — NEVER prefix with VITE_ or expose in browser)
SUPABASE_URL="https://plvjsiehhpdoyvzgahpr.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
